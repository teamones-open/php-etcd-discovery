        {
            "name": "Weijer Cheng",
            "email": "weiwei163@foxmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "workerman/workerman": "^5.1",
        "illuminate/redis": "^10.0 || ^11.0 || ^12.0",
        "teamones/log": ">=0.0.1",
        "teamones/http": "^0.0.4",
        "teamones/json-rpc": ">=0.0.1",
